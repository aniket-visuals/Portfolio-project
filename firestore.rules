rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone can read the portfolio data
      allow read: if true;
      
      // Only the admin email can write
      allow write: if request.auth != null && request.auth.token.email == 'aniketrajcargal123@gmail.com';
    }
  }
}
